{
  "name": "azure-agent-mcp-server",
  "version": "1.0.0",
  "description": "Azure AI Agent Service MCP Server",
  "type": "module",
  "bin": {
    "azure-agent-mcp-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && cpx \"src/scripts/**/*\" build/scripts",
    "build:unix": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "start:http": "node build/http-server.js",
    "start:ngrok": "node build/ngrok-server.js"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "azure",
    "ai",
    "agent",
    "mcp",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/ai-projects": "^1.0.0-beta.3",
    "@azure/identity": "^4.8.0",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@ngrok/ngrok": "^1.0.0",
    "cors": "^2.8.5",
    "cpx": "^1.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.11",
    "typescript": "^5.8.2"
  }
}
